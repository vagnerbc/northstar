{
  "realm": "ecommerce",
  "enabled": true,
  "displayName": "Northstar E-commerce",
  "registrationAllowed": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "roles": { "realm": [{ "name": "buyer", "description": "May use the buyer storefront" }] },
  "clientScopes": [
    {
      "name": "cart:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "inventory:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "payment:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "ecommerce-web",
      "name": "Northstar Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "web audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "web-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order service account",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["cart:read", "inventory:write", "payment:write"],
      "protocolMappers": [
        {
          "name": "cart audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.custom.audience": "cart-service", "access.token.claim": "true" }
        },
        {
          "name": "inventory audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "catalog-inventory-service",
            "access.token.claim": "true"
          }
        },
        {
          "name": "payment audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.custom.audience": "payment-service", "access.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "buyer",
      "email": "buyer@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Buyer",
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer123", "temporary": false }]
    }
  ]
}
