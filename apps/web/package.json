{
  "name": "@ecommerce/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "clean": "rimraf dist",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "orval --config orval.config.ts && prettier --write src/generated/api.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.36.1",
    "@emotion/react": "11.14.0",
    "@hookform/resolvers": "5.8.0",
    "@stripe/react-stripe-js": "6.8.1",
    "@stripe/stripe-js": "9.13.0",
    "@tanstack/react-query": "5.101.4",
    "keycloak-js": "26.2.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "30.0.1",
    "orval": "8.24.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
